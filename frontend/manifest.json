{
  "manifest_version": 3,
  "name": "Autotest - QA Automation",
  "version": "0.1.0",
  "description": "Record, replay, and debug user flows across environments with an intelligent on-page HUD",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "permissions": ["storage", "tabs", "activeTab", "tabCapture", "downloads", "scripting", "sidePanel", "cookies"],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Autotest - QA Automation",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/network-tracker-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/hud.js", "content/content.js"],
      "css": ["content/hud.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/video-recorder.js",
        "content/self-healing.js",
        "shared/page-context.js",
        "shared/cache.js",
        "popup/popup.html",
        "popup/popup.css",
        "popup/popup.js",
        "shared/storage.js"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}

